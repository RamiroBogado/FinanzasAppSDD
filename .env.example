SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=password-smtp
EMAIL_FROM=FinanzasApp <noreply@finanzasapp.com>

# Database
DB_PATH=./data/finanzas.db

# AI Service
